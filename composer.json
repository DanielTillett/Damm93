{
    "name": "danieltillett/damm93",
    "description": "Base93 implementation of the Damm check digit algorithm over visible ASCII",
    "type": "library",
    "keywords": [
        "damm",
        "check digit",
        "checksum",
        "base93",
        "error detection"
    ],
    "homepage": "https://github.com/DanielTillett/Damm93",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Daniel Tillett"
        }
    ],
    "support": {
        "issues": "https://github.com/DanielTillett/Damm93/issues",
        "source": "https://github.com/DanielTillett/Damm93"
    },
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "Damm93\\": "php/src/"
        }
    },
    "bin": [
        "php/bin/damm93"
    ],
    "scripts": {
        "test": "php php/tests/Damm93Test.php"
    }
}
